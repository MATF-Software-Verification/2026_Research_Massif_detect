<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:MassifVisualizer.Models"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="750"
        x:Class="MassifVisualizer.MainWindow"
        Title="MassifDetect — Heap Profiler Visualizer"
        Width="1200" Height="750"
        MinWidth="900" MinHeight="600">

  <DockPanel>

    <!-- Menu bar -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open massif file..." Name="MenuOpen"/>
        <MenuItem Header="Open _source file..." Name="MenuOpenSource"/>
        <Separator/>
        <MenuItem Header="E_xit" Name="MenuExit"/>
      </MenuItem>
    </Menu>

    <!-- Summary strip -->
    <Border DockPanel.Dock="Top" Background="WhiteSmoke" Padding="8,4"
            BorderBrush="Silver" BorderThickness="0,0,0,1">
      <TextBlock Name="SummaryText" Foreground="Black" FontSize="12"
                 Text="No file loaded. Open a massif output file, or a C source file to profile."/>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="WhiteSmoke" Padding="8,3"
            BorderBrush="Silver" BorderThickness="0,1,0,0">
      <DockPanel>
        <Button Name="CancelButton" DockPanel.Dock="Right" Content="Cancel"
                FontSize="11" Padding="10,0" IsVisible="False"/>
        <TextBlock Name="StatusBar" Foreground="DimGray" FontSize="11" Text="Ready"
                   VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- Compiler and valgrind output, shown only when there is something to report -->
    <Border Name="ToolOutputPanel" DockPanel.Dock="Bottom" Background="OldLace" Padding="8,6"
            BorderBrush="Silver" BorderThickness="0,1,0,0" IsVisible="False">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
          <Button Name="ToolOutputClose" DockPanel.Dock="Right" Content="Hide"
                  FontSize="11" Padding="10,0"/>
          <TextBlock Name="ToolOutputHeader" Foreground="Black" FontSize="12" FontWeight="Bold"
                     VerticalAlignment="Center"/>
        </DockPanel>
        <ScrollViewer MaxHeight="120" HorizontalScrollBarVisibility="Auto">
          <SelectableTextBlock Name="ToolOutputText" Foreground="Black"
                               FontFamily="Consolas,Menlo,monospace" FontSize="11"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Main layout: snapshot list on left, content on right -->
    <Grid ColumnDefinitions="230,4,*">

      <!-- Snapshot list -->
      <Border Grid.Column="0" Background="White" BorderBrush="Silver" BorderThickness="0,0,1,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="SNAPSHOTS" Foreground="DimGray"
                     FontSize="11" FontWeight="Bold" Padding="8,8,8,4"/>
          <ListBox Name="SnapshotList" Background="Transparent" SelectionMode="Single">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:MassifSnapshot">
                <Grid ColumnDefinitions="28,*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Index}"
                             Foreground="DimGray" FontSize="11" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding HeapDisplay}"
                             Foreground="Black" FontSize="11" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding TreeLabel}"
                             Foreground="Crimson" FontSize="10" FontWeight="Bold"
                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Splitter -->
      <GridSplitter Grid.Column="1" Background="Silver"/>

      <!-- Right panel -->
      <Grid Grid.Column="2" RowDefinitions="*,4,260">

        <!-- Chart rendered via ScottPlot core into an Image -->
        <Border Grid.Row="0" Background="LightGray" Name="ChartBorder">
          <Image Name="ChartImage" Stretch="Fill"/>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Row="1" Background="Silver"/>

        <!-- Bottom: tabs for call tree and stats -->
        <TabControl Grid.Row="2" Background="White">
          <TabControl.Styles>
            <Style Selector="TabItem">
              <Setter Property="FontSize" Value="14"/>
              <Setter Property="MinHeight" Value="36"/>
              <Setter Property="Padding" Value="10,0"/>
            </Style>
          </TabControl.Styles>


          <TabItem Header="Allocation Tree">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Grid.Row="0" Name="TreeHeader"
                         Text="Load a profile to see the allocation tree."
                         Foreground="DimGray" FontSize="12" Padding="8,6"/>
              <ListBox Grid.Row="1" Name="TreeList" Background="Transparent" SelectionMode="Single">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:HeapNode">
                    <TextBlock Text="{Binding DisplayText}"
                               FontFamily="Cascadia Code,Consolas,monospace"
                               FontSize="11" Foreground="Black" Padding="2,1"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>

          <TabItem Header="Snapshot Details">
            <ScrollViewer>
              <StackPanel Name="DetailsPanel" Spacing="6" Margin="12">
                <TextBlock Text="Load a profile to see snapshot details." Foreground="DimGray"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Hot Functions">
            <DockPanel>
              <Border DockPanel.Dock="Top" Padding="8,6" Background="WhiteSmoke"
                      BorderBrush="Silver" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="Show top:" VerticalAlignment="Center"
                             Foreground="DimGray" FontSize="12" Margin="0,0,6,0"/>
                  <RadioButton Name="TopN3"  Content=" 3 " GroupName="HotN" FontSize="12"/>
                  <RadioButton Name="TopN5"  Content=" 5 " GroupName="HotN" FontSize="12" IsChecked="True"/>
                  <RadioButton Name="TopN10" Content="10"  GroupName="HotN" FontSize="12"/>
                  <TextBlock Name="HotFunctionsHeader" VerticalAlignment="Center"
                             Foreground="DimGray" FontSize="12" Margin="16,0,0,0"
                             Text="Load a profile to see hot functions."/>
                </StackPanel>
              </Border>
              <ScrollViewer>
                <StackPanel Name="HotFunctionsPanel" Spacing="8" Margin="8"/>
              </ScrollViewer>
            </DockPanel>
          </TabItem>

          <TabItem Header="Findings">
            <DockPanel>
              <Border DockPanel.Dock="Top" Padding="8,6" Background="WhiteSmoke"
                      BorderBrush="Silver" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="Show:" VerticalAlignment="Center"
                             Foreground="DimGray" FontSize="12" Margin="0,0,6,0"/>
                  <CheckBox Name="FilterCritical" Content="Critical" FontSize="12" IsChecked="True"/>
                  <CheckBox Name="FilterWarning"  Content="Warning"  FontSize="12" IsChecked="True"/>
                  <CheckBox Name="FilterInfo"     Content="Info"     FontSize="12" IsChecked="True"/>
                  <TextBlock Name="FindingsHeader" VerticalAlignment="Center"
                             Foreground="DimGray" FontSize="12" Margin="16,0,0,0"
                             Text="Load a profile to see findings."/>
                </StackPanel>
              </Border>
              <ScrollViewer>
                <StackPanel Name="FindingsPanel" Spacing="8" Margin="8"/>
              </ScrollViewer>
            </DockPanel>
          </TabItem>

        </TabControl>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
