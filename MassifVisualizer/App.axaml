<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MassifVisualizer.App"
             RequestedThemeVariant="Light">
             <!-- Pinned to Light: the window hardcodes light backgrounds (white cards, WhiteSmoke
                  strips), so following a dark system theme renders unstyled text white-on-white. -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
    </Application.Styles>
</Application>